# Maintenance mode: when set to "true", all routes are blocked and a static maintenance page is shown.
# API routes return 503 JSON. The variable must be explicitly "true" to activate; absence or any other value means the site runs normally.
MAINTENANCE_MODE=false # Restricts the public site and administration to the documented maintenance capabilities when true.

# Canonical public URL used for browser-visible redirects/canonical links and trusted public origin checks.
NEXT_PUBLIC_SITE_URL=NEXT_PUBLIC_SITE_URL
# Internal app URL used by server-to-server self-calls (server actions/services -> app route handlers).
APP_INTERNAL_BASE_URL=APP_INTERNAL_BASE_URL
ALLOWED_PUBLIC_ORIGINS= # Optional comma-separated allowlist for additional public origins (e.g. cutover domains)

# Enables static generation of the known locale routes during build. Set to "true" to return i18n.locales from generateStaticParams and disable dynamic params; any other value returns [] and allows locale routes to be resolved dynamically.
ENABLE_STATIC_LOCALE_PARAMS=false

# Secret key used to authenticate internal server-to-server requests (e.g. server actions -> protected route handlers). Must never be exposed on the client.
INTERNAL_API_KEY=INTERNAL_API_KEY 

# Strapi integration
BUILD_STRAPI_BASE_URL=BUILD_STRAPI_BASE_URL # Base url where strapi is hosted
STRAPI_FORMS_TOKEN=STRAPI_FORMS_TOKEN # API Token used to create postulation records in Strapi after the CV is stored privately by the app server.
BUILD_STRAPI_CONTENT_TOKEN=BUILD_STRAPI_CONTENT_TOKEN # API Token used to access all the content that the public content, except for Public auth
BUILD_STRAPI_BUCKET_HOSTNAME=BUILD_STRAPI_BUCKET_HOSTNAME # Image bucket host from GCP (used by Strapi and the same-origin /api/media proxy).
BUILD_STRAPI_BUCKET_PATHNAME=BUILD_STRAPI_BUCKET_PATHNAME # Image bucket pathname from GCP (used to whitelist the same-origin media proxy).

# Private CV storage
CV_STORAGE_DRIVER=local # Determines where uploaded job application files are stored: local | gcs
CV_LOCAL_STORAGE_DIR=.private/job-applications # Local private folder for CV files when CV_STORAGE_DRIVER=local
GCS_BUCKET_NAME=GCS_BUCKET_NAME # Bucket used for private CVs when CV_STORAGE_DRIVER=gcs
GCS_PRIVATE_BASE_PATH=private/job-applications # GCS prefix used for private CV files
GCS_SIGNED_URL_TTL_SECONDS=300 # Optional TTL if you ever choose signed CV downloads

# https://authjs.dev/getting-started/deployment#auth_trust_host
AUTH_TRUST_HOST=AUTH_TRUST_HOST
AUTH_SECRET=AUTH_SECRET

# reCaptcha credentials
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=NEXT_PUBLIC_RECAPTCHA_SITE_KEY # Used to generate the token
RECAPTCHA_SECRET_KEY=RECAPTCHA_SECRET_KEY # Used to validate the generated token

# Variables for the contact form, obtained from the app registered in Google Auth Platform
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com # Unique ID of the created client in Google Auth Platform. Identifies your app to Google. Obtained in GCP.
GOOGLE_CLIENT_SECRET=xxxxx-xxxxx # Secret key linked to the client of GAP. Verifies that the request comes from your app. Obtained in GCP
OAUTH_REDIRECT_URI=http://localhost:3000/api/oauth/google/callback # URL where Google redirects the user after they approve or deny permissions. Required only for the one-time OAuth setup flow (`/api/oauth/google/init` + callback). Must exactly match the one registered in Google Auth Platform.
OAUTH_REFRESH_TOKEN=OAUTH_REFRESH_TOKEN # Long-lived token used to generate new access_tokens without user interaction. Does not expire unless access is revoked or credentials are regenerated. Captured after first-time authorization (never commit)
GMAIL_SENDER=GMAIL_SENDER # Authorized email address used to send messages from the form. Must match the authorized user address in GAP.
GMAIL_RECEIVER=GMAIL_RECEIVER # Email address that will receive the messages sent through the form.
# Note: Both sender and receiver can be the same email address.
INIT_TOKEN=short-lived-admin-token # Temporary token to authorize the initialization request of the oauth gmail authorization flow. 
CSRF_STATE_SECRET=some-long-random-secret # This is used to sign the state cookie to prevent CSRF attacks. It can be any long random string.

# Form Protection & Rate Limiting
# The form protection system has two distinct layers:
# 1. Rate Limit (IP-based, Redis): Protects against bots and brute force at the connection level.
# 2. Email Limit (Business rule, Strapi): Protects against spam and enforces the business rule per-email.
FORM_PROTECTION_REDIS_URL=redis://127.0.0.1:6379 # Local development defaults to a local Redis container. Do NOT use managed remote Redis locally.
FORM_PROTECTION_REDIS_NAMESPACE=development # Namespace to avoid key collisions if multiple environments share the same Redis instance.
FORM_PROTECTION_REDIS_CONNECT_TIMEOUT_MS=500
CONTACT_RATE_LIMIT_ENABLED=true
CONTACT_RATE_LIMIT_MAX=10
CONTACT_RATE_LIMIT_WINDOW_MS=3600000
CONTACT_EMAIL_LIMIT_ENABLED=true
CONTACT_EMAIL_LIMIT_MAX=5
CONTACT_EMAIL_LIMIT_WINDOW_MS=86400000
POSTULATION_RATE_LIMIT_ENABLED=false
POSTULATION_RATE_LIMIT_MAX=5
POSTULATION_RATE_LIMIT_WINDOW_MS=900000
POSTULATION_EMAIL_LIMIT_ENABLED=true
POSTULATION_EMAIL_LIMIT_MAX=2
POSTULATION_EMAIL_LIMIT_WINDOW_MS=2592000000

# Playwright real-auth harness variables. They are generated for one ephemeral NODE_ENV=test run and must never be used in staging or production.
PLAYWRIGHT_REAL_AUTH_BASE_URL= # Exact harness-owned Next.js origin: http://127.0.0.1:3200
PLAYWRIGHT_REAL_AUTH_MARKER= # Non-secret marker used to identify the run's synthetic postulation.
PLAYWRIGHT_REAL_AUTH_ADMIN_EMAIL= # Run-scoped synthetic Administrator login generated by the harness.
PLAYWRIGHT_REAL_AUTH_ADMIN_PASSWORD= # Run-scoped synthetic Administrator password; never log or persist it.
PLAYWRIGHT_REAL_AUTH_MEDIA_EMAIL= # Run-scoped synthetic Media Manager login generated by the harness.
PLAYWRIGHT_REAL_AUTH_MEDIA_PASSWORD= # Run-scoped synthetic Media Manager password; never log or persist it.
PLAYWRIGHT_REAL_AUTH_KNOWN_STRAPI_JWT= # Server-side comparison value used only to prove that browser-visible surfaces do not expose a Strapi JWT.
