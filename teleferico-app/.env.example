# Base url of the frontend
NEXT_PUBLIC_BASE_URL=NEXT_PUBLIC_BASE_URL
ALLOWED_PUBLIC_ORIGINS= # Optional comma-separated allowlist for additional public origins (e.g. preview/cutover domains)

# Enables static generation of the known locale routes during build. Set to "true" to return i18n.locales from generateStaticParams and disable dynamic params; any other value returns [] and allows locale routes to be resolved dynamically.
ENABLE_STATIC_LOCALE_PARAMS=false

# Secret key used to authenticate internal server-to-server requests (e.g. server actions -> protected route handlers). Must never be exposed on the client.
INTERNAL_API_KEY=INTERNAL_API_KEY 

# Strapi integration
BUILD_STRAPI_BASE_URL=BUILD_STRAPI_BASE_URL # Base url where strapi is hosted
STRAPI_FORMS_TOKEN=STRAPI_FORMS_TOKEN # API Token used to create postulation records in Strapi after the CV is stored privately by the app server.
BUILD_STRAPI_CONTENT_TOKEN=BUILD_STRAPI_CONTENT_TOKEN # API Token used to access all the content that the public content, except for Public auth
BUILD_STRAPI_BUCKET_HOSTNAME=BUILD_STRAPI_BUCKET_HOSTNAME # Image bucket host from GCP (used by Strapi), configured in Next.js to enable image loading.
BUILD_STRAPI_BUCKET_PATHNAME=BUILD_STRAPI_BUCKET_PATHNAME # Image bucket pathname from GCP (used by Strapi)

# Private CV storage
CV_STORAGE_DRIVER=local # Determines where uploaded job application files are stored: local | gcs
CV_LOCAL_STORAGE_DIR=.private/job-applications # Local private folder for CV files when CV_STORAGE_DRIVER=local
GCS_BUCKET_NAME=GCS_BUCKET_NAME # Bucket used for private CVs when CV_STORAGE_DRIVER=gcs
GCS_PRIVATE_BASE_PATH=private/job-applications # GCS prefix used for private CV files
GCS_SIGNED_URL_TTL_SECONDS=300 # Optional TTL if you ever choose signed CV downloads

# https://authjs.dev/getting-started/deployment#auth_trust_host
AUTH_TRUST_HOST=AUTH_TRUST_HOST
AUTH_SECRET=AUTH_SECRET

# reCaptcha credentials
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=NEXT_PUBLIC_RECAPTCHA_SITE_KEY # Used to generate the token
RECAPTCHA_SECRET_KEY=RECAPTCHA_SECRET_KEY # Used to validate the generated token

# Variables for the contact form, obtained from the app registered in Google Auth Platform
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com # Unique ID of the created client in Google Auth Platform. Identifies your app to Google. Obtained in GCP.
GOOGLE_CLIENT_SECRET=xxxxx-xxxxx # Secret key linked to the client of GAP. Verifies that the request comes from your app. Obtained in GCP
OAUTH_REDIRECT_URI=http://localhost:3000/api/oauth/google/callback # URL where Google redirects the user after they approve or deny permissions. Must exactly match the one registered in Google Auth Platform.
OAUTH_ACCESS_TOKEN=OAUTH_ACCESS_TOKEN # Short-lived token that authorizes your app to access Google APIs on behalf of the user. Captured after first-time authorization (never commit)
OAUTH_REFRESH_TOKEN=OAUTH_REFRESH_TOKEN # Long-lived token used to generate new access_tokens without user interaction. Does not expire unless access is revoked or credentials are regenerated. Captured after first-time authorization (never commit)
OAUTH_TOKEN_EXPIRY_DATE=OAUTH_TOKEN_EXPIRY_DATE # Expiry date of the access token in timestamp format 
GMAIL_SENDER=GMAIL_SENDER # Authorized email address used to send messages from the form. Must match the authorized user address in GAP.
GMAIL_RECEIVER=GMAIL_RECEIVER # Email address that will receive the messages sent through the form.
# Note: Both sender and receiver can be the same email address.
INIT_TOKEN=short-lived-admin-token # Temporary token to authorize the initialization request of the oauth gmail authorization flow. 
CSRF_STATE_SECRET=some-long-random-secret # This is used to sign the state cookie to prevent CSRF attacks. It can be any long random string.
