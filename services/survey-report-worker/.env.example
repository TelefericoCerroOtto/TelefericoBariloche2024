# Survey report worker configuration.
# Never commit real tokens, credentials, or secret key bytes.

# Strapi connection. Both values must use the same exact origin.
BUILD_STRAPI_BASE_URL=http://localhost:1337
FEEDBACK_CMS_ALLOWED_ORIGIN=http://localhost:1337

# Worker-only Strapi Custom Content API token.
# Required permissions under Survey report generation:
# workerClaim, workerSnapshot, workerCheckpoint, workerComplete, workerFail.
FEEDBACK_WORKER_CMS_TOKEN=

# Local worker execute endpoint.
# pnpm dev also starts the local queue on the next port: 8081.
FEEDBACK_WORKER_URL=http://127.0.0.1:8080/internal/v1/report-runs:execute

# Queue resource path. Local development emulates this queue.
FEEDBACK_TASK_QUEUE_PATH=projects/teleferico-bariloche-2024/locations/southamerica-east1/queues/feedback-reports

# Approved Vertex project for model generation and CountTokens.
# Local development uses Application Default Credentials (ADC).
FEEDBACK_VERTEX_PROJECT_ID=teleferico-bariloche-2024

# Pinned numeric Secret Manager version resource, never secret key bytes.
# Format: projects/<project>/secrets/<secret>/versions/<number>
# Development uses this metadata to derive a synthetic local evidence key
# without contacting Secret Manager.
FEEDBACK_WORKER_EVIDENCE_KEY=

# Production-only private GCS bucket name, without gs://.
# Development stores private PDFs locally instead of using GCS.
FEEDBACK_PRIVATE_BUCKET=

# Production-only Cloud Tasks OIDC identity settings.
# Local development uses its own signed loopback identity.
FEEDBACK_TASK_INVOKER_EMAIL=
FEEDBACK_WORKER_OIDC_AUDIENCE=
FEEDBACK_WORKER_OIDC_PRINCIPAL=