## STRAPI SERVER ##
# Specifies the type of configuration being used.
NODE_ENV=production 
# Strapi IP direction
HOST=0.0.0.0
# Port where Strapi is running
PORT=1337
# Secret keys used to sign the session cookies
APP_KEYS="toBeModified1,toBeModified2"
# Salt for api token
API_TOKEN_SALT=tobemodified
# Secret used to sign the JWT for the Admin panel
ADMIN_JWT_SECRET=tobemodified
# Salt for transfer token
TRANSFER_TOKEN_SALT=tobemodified
# Secret to sign the JWT for the Users-Permissions plugin
JWT_SECRET=tobemodified

## DATABASE ##
# Selected database. It can be postgres/mysql/mysql2/sqlite
DATABASE_CLIENT=postgres
# Database IP. It is not necessary to define it in app.yaml, strapi uses INSTANCE_CONNECTION_NAME
DATABASE_HOST=0.0.0.0
# Database port. It is not necessary to define it in app.yaml, strapi uses INSTANCE_CONNECTION_NAME
DATABASE_PORT=5432
# Database name
DATABASE_NAME=NAME
# Username with enough permissions to edit the database
DATABASE_USERNAME=USERNAME
# User password
DATABASE_PASSWORD=PASSWORD
# connection name of the google sql instance
INSTANCE_CONNECTION_NAME=projectid:region:db-instance-name
# Google Storage bucket name
GCS_BUCKET_NAME=GCS_BUCKET_NAME
# bucket path where public CMS objects will be stored
GCS_BASE_PATH=public/cms
# public base URL for bucket objects
GCS_BASE_URL=https://storage.googleapis.com/<bucket-name>
# public files stay readable, but only for public CMS assets
GCS_PUBLIC_FILES=true
# Uniform bucket-level access should be enabled
GCS_UNIFORM=true

## PLAYWRIGHT REAL-AUTH (EPHEMERAL TEST HARNESS ONLY) ##
# Internal root-harness capability selector; the dedicated wrapper sets "real-auth" and readiness defaults independently.
TB122_HARNESS_CAPABILITY=
# Outer harness opt-in accepted only as "run" before any real-auth container is created.
PLAYWRIGHT_REAL_AUTH_HARNESS_OPT_IN=
# Explicit fail-closed opt-in accepted only as "provision" with NODE_ENV=test.
PLAYWRIGHT_REAL_AUTH_OPT_IN=
# Harness-derived 24-character hexadecimal identity for one disposable run.
PLAYWRIGHT_REAL_AUTH_RUN_ID=
# Exact harness-owned PostgreSQL host and database identity checked before writes.
PLAYWRIGHT_REAL_AUTH_EXPECTED_DATABASE_HOST=
PLAYWRIGHT_REAL_AUTH_EXPECTED_DATABASE_NAME=
# Run-scoped non-secret manifest path under /tmp; credentials are never stored in it.
PLAYWRIGHT_REAL_AUTH_MANIFEST_PATH=
# Synthetic credentials generated inside the harness and never logged or persisted.
PLAYWRIGHT_REAL_AUTH_ADMIN_EMAIL=
PLAYWRIGHT_REAL_AUTH_ADMIN_PASSWORD=
PLAYWRIGHT_REAL_AUTH_MEDIA_EMAIL=
PLAYWRIGHT_REAL_AUTH_MEDIA_PASSWORD=
