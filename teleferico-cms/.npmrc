# npm 11 supply-chain security settings for teleferico-cms (Strapi).
#
# This file is read automatically by `npm ci` during:
#   - local development installs
#   - Docker-based Cloud Build installs (the Dockerfile runs `npm ci`)
#
# It intentionally mirrors the global ~/.npmrc baseline so that CI
# and fresh developer environments have the same security posture.

# Disable lifecycle scripts (postinstall, preinstall, etc.) of dependencies.
# Own package scripts defined in package.json scripts section are unaffected:
# `npm run build` and `npm run start` still work normally.
ignore-scripts=true

# Block dependencies sourced from git repositories (git+https://, git+ssh://).
# Such sources bypass npm registry security scanning and signature checks.
allow-git=none

# Cooldown: only resolve package versions published at least 3 days ago.
# Newly released malicious packages are typically removed within hours.
min-release-age=3

# Save exact versions (no ^ prefix) for future `npm install <pkg>` calls.
save-exact=true
