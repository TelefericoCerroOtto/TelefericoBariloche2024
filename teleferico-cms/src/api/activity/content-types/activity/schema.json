{
  "kind": "collectionType",
  "collectionName": "activities",
  "info": {
    "singularName": "activity",
    "pluralName": "activities",
    "displayName": "Activity",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "price": {
      "pluginOptions": {},
      "type": "integer",
      "required": true
    },
    "minAge": {
      "pluginOptions": {},
      "type": "integer",
      "default": 0,
      "required": true,
      "min": 0,
      "max": 99
    },
    "zone": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::zone.zone"
    },
    "label": {
      "type": "string",
      "required": false,
      "unique": true
    },
    "pages": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::page.page"
    },
    "activity_translations": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::activity-translation.activity-translation",
      "mappedBy": "activity"
    },
    "season": {
      "type": "enumeration",
      "enum": [
        "summer",
        "autumn",
        "winter",
        "spring",
        "allSeasons"
      ]
    }
  }
}
