{
  "kind": "collectionType",
  "collectionName": "survey_qr_points",
  "info": {
    "singularName": "survey-qr-point",
    "pluralName": "survey-qr-points",
    "displayName": "Survey QR point"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "pointKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "required": true,
      "unique": true,
      "regex": "^[a-z0-9][a-z0-9._-]*$"
    },
    "publicCode": {
      "type": "string",
      "minLength": 32,
      "maxLength": 128,
      "required": true,
      "unique": true,
      "regex": "^[A-Za-z0-9_-]+$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "required": true
    },
    "qrPointStatus": {
      "type": "enumeration",
      "required": true,
      "default": "active",
      "enum": [
        "active",
        "inactive"
      ]
    },
    "inactiveAt": {
      "type": "datetime"
    },
    "sortOrder": {
      "type": "integer",
      "required": true,
      "min": 0
    },
    "fixtureMarker": {
      "type": "string",
      "private": true,
      "maxLength": 64
    }
  }
}
